# Ambiente do Flask (development | production | testing)
FLASK_ENV="development"
# Porta 5001: a 5000 é ocupada pelo AirPlay Receiver no macOS
PORT="5001"

# Origens permitidas pelo Flask-CORS (separadas por vírgula)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# Banco PostgreSQL no Neon (connection string do painel do Neon ou da Vercel → Storage)
DATABASE_URL="postgresql://usuario:senha@ep-exemplo-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# Segredo que assina os tokens de login. Gere um com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=""
# Duração do login, em horas
JWT_EXPIRES_HOURS=12
