# Ambiente do Flask (development | production | testing)
FLASK_ENV="development"
PORT="5000"

# Origens permitidas pelo Flask-CORS (separadas por vírgula)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# Credenciais do Supabase
# ATENÇÃO: Nunca exponha SUPABASE_SERVICE_ROLE_KEY no frontend!
SUPABASE_URL="https://seu-projeto.supabase.co"
SUPABASE_ANON_KEY="sua-chave-publica-anon-key"
SUPABASE_SERVICE_ROLE_KEY="sua-chave-secreta-service-role-key"
